# Cloud Phone 环境配置（复制为 .env 后按需修改）

# 默认只监听回环：后端自身是明文 HTTP，绑 0.0.0.0 等于把会话 Cookie 暴露给整个局域网。
# 需要局域网/手机访问时显式改成 0.0.0.0，并务必通过 5173 的 HTTPS 入口访问（不要直连 3000）。
HOST=127.0.0.1
# 会话有效期（天）。默认 30；缩短会让被嗅探的 Cookie 更快失效。
# AUTH_SESSION_DAYS=30
# 登录失败节流（默认：同 IP 5 分钟 5 次失败后锁 15 分钟，全局 10 分钟 20 次）
# LOGIN_IP_MAX_FAILURES=5
# LOGIN_IP_LOCK_MS=900000
# 请求体上限（字节）：普通 JSON 默认 1 MiB，安装包/文件上传默认 256 MiB
# MAX_JSON_BODY_BYTES=1048576
# UPLOAD_MAX_BYTES=268435456

# 后端 API 端口（仅提供 /api 与 /health）
BACKEND_PORT=3000

# Prometheus 指标端点（GET /metrics）
# 不设 token 时只允许回环地址（127.0.0.1 / ::1）抓取，其它来源一律 404（不暴露端点存在）。
# 一旦设置 token，所有来源（含本机）都必须带 Authorization: Bearer <token>，否则 404。
# token 只放环境变量，不要写进仓库；长度建议 ≥24 字节随机串（openssl rand -hex 24）。
# METRICS_TOKEN=

# 前端页面端口（静态资源 + /api 代理到后端）
FRONTEND_PORT=5173

# 生产前端 HTTPS（Docker server.mjs 默认开启；局域网访问请用 https://<IP>:5173）
FRONTEND_HTTPS=1
# FRONTEND_TLS_SAN=192.168.1.10

# 后端自身 TLS（默认关）。开启后后端以 https 提供 /api，反代自动改用 https 客户端。
# 证书优先级：BACKEND_TLS_CERT + BACKEND_TLS_KEY > 自动生成自签证书（落盘 backend/node/data/.tls，复用不重签）。
# BACKEND_TLS=1
# BACKEND_TLS_SANS=192.168.1.10,cloud-phone.lan
# BACKEND_TLS_CERT=/etc/ssl/cloud-phone/fullchain.pem
# BACKEND_TLS_KEY=/etc/ssl/cloud-phone/privkey.pem
# 远端后端使用自签证书时才需要（环回地址默认已放行自签）
# BACKEND_TLS_INSECURE=1

# Docker Compose（docker-cloud-phone/）
# Compose 只读取 docker-cloud-phone/.env 做端口替换，根目录 .env 需：
#   cd docker-cloud-phone && ./compose.sh up -d
# 或: docker compose --env-file ../.env up -d
# 或: ln -sf ../.env docker-cloud-phone/.env && cd docker-cloud-phone && docker compose up -d
DOCKERHUB_NAMESPACE=yiyifred
# 与 package.json / APP_VERSION 一致；compose 拉取镜像时使用此 tag
IMAGE_TAG=0.14.1

# 多架构构建（build-multiarch.sh / GitHub Actions）：默认 amd64 + arm64
DOCKER_PLATFORMS=linux/amd64,linux/arm64

# Docker host 网络（Linux 默认 compose 已启用；bridge 模式设为 0）
# Mac/Windows: cd docker-cloud-phone && ./compose.sh -f docker-compose.yml -f docker-compose.bridge.yml up -d
CLOUD_PHONE_USE_HOST_NETWORK=1
# Docker 后端数据目录（compose 默认挂载 docker-cloud-phone/data -> 容器 /data）
# CLOUD_PHONE_DATA_DIR=/data
# Docker/Linux 优先使用系统 adb（镜像内 apt 安装的 android-tools-adb）
CLOUD_PHONE_PREFER_SYSTEM_ADB=1
# 指定 mDNS / 主 LAN IPv4（可选，默认自动选取 RFC1918 地址）
# CLOUD_PHONE_LAN_IP=192.168.1.10
