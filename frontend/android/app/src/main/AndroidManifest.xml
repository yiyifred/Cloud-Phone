<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- T-414：allowBackup 关闭——应用本地存了后端地址与会话 Cookie，adb backup /
         云备份能整包导出，等于把凭据搬出设备；备份规则同时收紧为「全部排除」。
         明文流量保留开启：本产品就是连局域网 http 自建后端（客户端与后端都只有 http），
         release 一刀切禁明文会让 App 连不上任何设备。真正的收敛放在
         res/xml/network_security_config.xml：只信任系统 CA，用户自装证书不参与校验，
         「装张证书就能长期抓包」这条路被堵住；debug 变体再放开用户 CA 供调试。 -->
    <application
        android:name=".CloudPhoneApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloudPhone">
        <activity
            android:name=".ConsoleActivity"
            android:exported="false" />
        <activity
            android:name=".DeviceWorkspaceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:parentActivityName=".ConsoleActivity" />
        <activity
            android:name=".files.DeviceFileExplorerActivity"
            android:exported="false"
            android:parentActivityName=".DeviceWorkspaceActivity" />
        <activity
            android:name=".apps.DeviceAppManagerActivity"
            android:exported="false"
            android:parentActivityName=".DeviceWorkspaceActivity" />
        <activity
            android:name=".terminal.DeviceTerminalActivity"
            android:exported="false"
            android:parentActivityName=".DeviceWorkspaceActivity" />
        <activity
            android:name=".cast.CastFullscreenActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.CloudPhone" />
        <activity
            android:name=".multiapp.MultiAppDesktopActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensorLandscape"
            android:parentActivityName=".DeviceWorkspaceActivity"
            android:theme="@style/Theme.CloudPhone" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>