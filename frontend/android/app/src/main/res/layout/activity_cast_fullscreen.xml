<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/castRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/auth_preview_bg">

    <TextureView
        android:id="@+id/castTexture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <LinearLayout
        android:id="@+id/castToolbarDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/cast_panel_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <HorizontalScrollView
            android:id="@+id/castToolbarScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="320dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/castToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/castToolbarToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cast_toolbar_button_bg"
            android:contentDescription="@string/cast_toolbar_collapse"
            android:padding="8dp"
            android:scaleType="centerInside" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/castOverlayLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B1220"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/auth_primary"
            app:indicatorSize="48dp"
            app:trackColor="#33FFFFFF"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/castLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cast_starting"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/castOverlayError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0B1220"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/castErrorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/castErrorClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cast_stop" />
    </LinearLayout>

    <View
        android:id="@+id/castScreenshotFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9FFFFFF"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
