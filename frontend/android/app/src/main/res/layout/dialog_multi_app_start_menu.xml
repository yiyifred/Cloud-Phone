<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_win11_start_menu"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingTop="14dp">

    <EditText
        android:id="@+id/editStartMenuSearch"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_win11_search_pill"
        android:hint="@string/multi_app_search_apps"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="#1F1F1F"
        android:textColorHint="#666666"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textStartMenuStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#666666"
        android:textSize="13sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressStartMenu"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:indeterminate="true"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerStartMenuApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#8CFFFFFF"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:id="@+id/buttonStartMenuFullscreen"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_taskbar_btn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/imageStartMenuFullscreen"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_win11_fullscreen" />

            <TextView
                android:id="@+id/textStartMenuFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/multi_app_toggle_fullscreen"
                android:textColor="#1F1F1F"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
