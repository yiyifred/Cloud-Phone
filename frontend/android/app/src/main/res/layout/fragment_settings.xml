<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_eyebrow"
            android:textAllCaps="false"
            android:textColor="@color/auth_primary"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tab_settings"
            android:textColor="@color/auth_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_desc"
            android:textColor="@color/auth_text_secondary"
            android:textSize="14sp" />

        <include
            android:id="@+id/sectionAccount"
            layout="@layout/settings_section_account" />

        <include
            android:id="@+id/sectionAppearance"
            layout="@layout/settings_section_appearance" />

        <include
            android:id="@+id/sectionRefresh"
            layout="@layout/settings_section_refresh" />

        <include
            android:id="@+id/sectionServer"
            layout="@layout/settings_section_server" />
    </LinearLayout>
</ScrollView>
