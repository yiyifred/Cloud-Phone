<?xml version="1.0" encoding="utf-8"?>
<!--
  T-414：API 31+ 的数据提取规则（dataExtractionRules）。
  cloud-backup 对应云备份，device-transfer 对应换机迁移；两个通道都要整棵排除，
  否则「不备份但允许换机迁移」等于留了同一条外泄路径。
  域清单与 backup_rules.xml 保持一致，便于对照维护。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
