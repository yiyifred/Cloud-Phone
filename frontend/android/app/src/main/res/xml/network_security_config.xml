<?xml version="1.0" encoding="utf-8"?>
<!--
  T-414：只信任系统 CA；明文保留（原因见下）。

  为什么这样配：
  本产品连的是局域网 http 自建后端（CloudPhoneApiClient.java:369、AuthApiClient.java:192、
  MainActivity.java:456、SessionCookieHelper.java:23 全是硬编码 http；后端
  backend/node/src/app.js:42 也只有 http），明文字段关掉等于让 release 包连不上任何设备。
  能收敛又不破坏可用性的是「不信任用户证书」：以前装一张自签 CA 就能长期中间人抓走登录
  凭据与会话 Cookie，现在只认系统 CA，普通用户装不进系统 CA，这条路走不通。
  需要抓包时用 debug 变体：src/debug/res/xml/network_security_config.xml 是同名资源覆盖，
  额外信任 user CA。
  后端支持 https 后，把 cleartextTrafficPermitted 改回 false 并改客户端 scheme。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <!-- 只信任系统 CA：用户自装的证书不参与本应用校验，避免「装个证书」
             就能长期抓包 -->
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>