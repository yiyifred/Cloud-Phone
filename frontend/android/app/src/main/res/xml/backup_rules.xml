<?xml version="1.0" encoding="utf-8"?>
<!--
  T-414：API < 31 的自动备份规则（fullBackupContent）。
  应用本地保存了后端地址、会话 Cookie 与设备列表缓存，任何一项被 adb backup /
  云备份带出设备都等于凭据外泄，所以这里把每个可备份域整棵排除。
  逐个域写 exclude 而不是只写 root：root 域并不覆盖 sharedpref / database /
  external 这些独立物理路径（见 developer.android.com/guide/topics/data/autobackup）。
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
